{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js application foundation for Personal-Website",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/routes.test.mjs tests/navbar.test.mjs tests/theme.test.mjs tests/theme-provider.test.mjs tests/architecture.test.mjs tests/footer.test.mjs tests/accordion.test.mjs tests/button.test.mjs tests/home-shell.test.mjs tests/home-footer-ui.test.mjs",
    "test:http": "node --experimental-strip-types tests/http-smoke.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,mjs,ts}\" .eslintrc.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,mjs,ts}\" .eslintrc.json .prettierrc.json"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "next": "^16.1.0",
    "next-themes": "0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.0"
  }
}
